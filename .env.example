# Database
# Local development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./dil_dev.db
# Production (PostgreSQL) - uncomment and configure for production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dil

# API Security
# Secret key for JWT signing (if using JWT tokens)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Model Configuration
TABULAR_MODEL_PATH=./models/tabular_mlp.pth
IMAGING_MODEL_PATH=./models/imaging_densenet121_lstm.pth
SCALER_PATH=./models/scaler.joblib

# Device Configuration (auto-detected at runtime, but can be forced)
# FORCE_CPU=true

# Logging
LOG_LEVEL=INFO

# External Services (if needed)
# HUGGINGFACE_TOKEN=your-hf-token-for-private-datasets