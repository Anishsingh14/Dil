# Database
# Local development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./dil_dev.db
# Production (MySQL) - uncomment and configure for production
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dil
# Production (PostgreSQL) - alternative
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dil

# Database Pool Settings
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# API Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_EXPIRATION_DAYS=365

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Redis (for distributed rate limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Model Configuration
TABULAR_MODEL_PATH=./models/tabular_xgb.pkl
IMAGING_MODEL_PATH=./models/imaging_densenet121_lstm.pth
SCALER_PATH=./models/scaler.joblib

# Device Configuration (auto-detected at runtime, but can be forced)
# FORCE_CPU=true

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Graceful Shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=30

# External Services (if needed)
# CHEXPERT_SAS_URL=your-azure-sas-url-here